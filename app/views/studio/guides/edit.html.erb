<% page_title "Edit #{@guide.title}" %>

<section class="studio-editor section-pad">
  <nav class="breadcrumbs"><%= link_to "Studio", studio_root_path %><span>/</span><strong><%= @guide.title %></strong></nav>
  <header><span class="eyebrow">Lexxy authoring</span><h1>Edit guide.</h1><p>Type Markdown shortcuts or paste a Markdown document. Lexxy converts it into canonical Action Text HTML.</p></header>

  <%= form_with model: [:studio, @guide], class: "editor-form" do |form| %>
    <% if @guide.errors.any? %><div class="form-errors"><strong>Check these fields:</strong><%= @guide.errors.full_messages.to_sentence %></div><% end %>
    <div class="editor-meta"><label>Title <%= form.text_field :title, required: true %></label><label>Summary <%= form.text_area :summary, rows: 3, required: true %></label></div>
    <div class="lexxy-shell">
      <div class="lexxy-shell__bar"><span><i></i> Lexxy editor</span><small>Markdown enabled</small></div>
      <%= form.rich_text_area :body, placeholder: "Write the guide… Markdown shortcuts work here." %>
    </div>
    <div class="editor-actions"><%= link_to "Cancel", guide_path(@guide), class: "button button--ghost" %><%= form.submit "Publish changes", class: "button button--primary" %></div>
  <% end %>
</section>
